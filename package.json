{
  "name": "ayre-aviation-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Ayre Aviation broker CRM. Frontend prototype on mock JSON data (no live backend, Avinode or Paynode).",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "theme:generate": "tsx scripts/generate-theme-css.ts",
    "predev": "pnpm theme:generate",
    "prebuild": "pnpm theme:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm theme:generate && tsc --noEmit",
    "test": "vitest run",
    "check:colors": "tsx scripts/check-no-raw-colors.ts",
    "check:layers": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write src scripts docs *.json *.mjs *.mts *.md",
    "format:check": "prettier --check src scripts docs *.json *.mjs *.mts *.md",
    "verify": "pnpm format:check && pnpm lint && pnpm check:layers && pnpm check:colors && pnpm typecheck && pnpm test && pnpm build"
  }
}
